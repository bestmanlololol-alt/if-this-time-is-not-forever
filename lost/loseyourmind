                    default = Library._config._flags[wflag]
                end

                local row = new_widget_row(24)
                new_widget_label(row, wtitle, 0, 180, 4, 12)

                local box = Instance.new('Frame')
                box.BackgroundColor3 = Color3.fromRGB(50, 55, 68)
