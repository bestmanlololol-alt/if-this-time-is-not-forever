                box.Size = UDim2.new(0, 16, 0, 16)
                box.Position = UDim2.new(1, -18, 0.5, -8)
                box.Parent = row
                local bc = Instance.new('UICorner')
                bc.CornerRadius = UDim.new(0, 4)
                bc.Parent = box

                local check = Instance.new('TextLabel')
                check.BackgroundTransparency = 1
                check.Text = "✓"
                check.TextColor3 = Color3.fromRGB(255, 255, 255)
                check.FontFace = Font.new('rbxasset://fonts/families/GothamSSm.json', Enum.FontWeight.Bold, Enum.FontStyle.Normal)
                check.TextSize = 12
                check.Size = UDim2.fromScale(1, 1)
                check.TextTransparency = 1
                check.Parent = box

                local btn = Instance.new('TextButton')
                btn.BackgroundTransparency = 1
                btn.Text = ''
                btn.Size = UDim2.fromScale(1, 1)
                btn.Parent = row

                local checked = default and true or false
                local function apply(state, fire)
                    checked = state
                    if state then
                        TweenService:Create(box, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(98, 160, 226)}):Play()
                        TweenService:Create(check, TweenInfo.new(0.2), {TextTransparency = 0}):Play()
                    else
                        TweenService:Create(box, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(50, 55, 68)}):Play()
                        TweenService:Create(check, TweenInfo.new(0.2), {TextTransparency = 1}):Play()
                    end
                    Library._config._flags[wflag] = state
                    if fire then task.spawn(wcallback, state) end
                end
                apply(checked, false)
                btn.MouseButton1Click:Connect(function() apply(not checked, true) end)
                return { set = apply, get = function() return checked end }
            end

            function ModuleManager:create_slider(opts)
                opts = opts or {}
                local wtitle = opts.title or "Slider"
                local wflag = opts.flag or (mflag .. "_" .. wtitle:lower():gsub("%s+", "_"))
                local wcallback = opts.callback or function() end
                local min_v = opts.minimum_value or opts.min or 0
                local max_v = opts.maximum_value or opts.max or 100
                local round = opts.round_number ~= false
                local default = opts.value
                if default == nil and Library._config._flags[wflag] ~= nil then
                    default = Library._config._flags[wflag]
                end
                default = math.clamp(default or min_v, min_v, max_v)

                local row = new_widget_row(40)
                new_widget_label(row, wtitle, 0, 160, 0, 12)

                local val_lbl = Instance.new('TextLabel')
                val_lbl.BackgroundTransparency = 1
                val_lbl.Text = tostring(default)
                val_lbl.TextColor3 = Color3.fromRGB(140, 146, 160)
                val_lbl.FontFace = Font.new('rbxasset://fonts/families/GothamSSm.json', Enum.FontWeight.Regular, Enum.FontStyle.Normal)
                val_lbl.TextSize = 12
                val_lbl.TextXAlignment = Enum.TextXAlignment.Right
                val_lbl.Position = UDim2.new(1, -80, 0, 0)
                val_lbl.Size = UDim2.new(0, 80, 0, 16)
                val_lbl.Parent = row

                local track = Instance.new('Frame')
                track.BackgroundColor3 = Color3.fromRGB(40, 44, 54)
                track.BorderSizePixel = 0
                track.Size = UDim2.new(1, 0, 0, 6)
                track.Position = UDim2.new(0, 0, 0, 24)
                track.Parent = row
                local tc = Instance.new('UICorner')
                tc.CornerRadius = UDim.new(1, 0)
                tc.Parent = track

                local fill = Instance.new('Frame')
                fill.BackgroundColor3 = Color3.fromRGB(98, 160, 226)
                fill.BorderSizePixel = 0
                fill.Size = UDim2.new((default - min_v) / math.max(max_v - min_v, 0.0001), 0, 1, 0)
                fill.Parent = track
                local fc = Instance.new('UICorner')
                fc.CornerRadius = UDim.new(1, 0)
                fc.Parent = fill

                local knob = Instance.new('Frame')
                knob.BackgroundColor3 = Color3.fromRGB(238, 240, 246)
                knob.BorderSizePixel = 0
                knob.Size = UDim2.new(0, 12, 0, 12)
                knob.AnchorPoint = Vector2.new(0.5, 0.5)
                knob.Position = UDim2.new((default - min_v) / math.max(max_v - min_v, 0.0001), 0, 0.5, 0)
                knob.Parent = track
                local kc = Instance.new('UICorner')
                kc.CornerRadius = UDim.new(1, 0)
                kc.Parent = knob

                local current = default
                local dragging = false
                local function apply(v, fire)
                    v = math.clamp(v, min_v, max_v)
                    if round then v = math.floor(v + 0.5) end
                    current = v
                    local alpha = (v - min_v) / math.max(max_v - min_v, 0.0001)
                    fill.Size = UDim2.new(alpha, 0, 1, 0)
                    knob.Position = UDim2.new(alpha, 0, 0.5, 0)
                    val_lbl.Text = round and tostring(math.floor(v)) or string.format("%.2f", v)
                    Library._config._flags[wflag] = v
                    if fire then task.spawn(wcallback, v) end
                end
                apply(default, false)

                local function pointer_to_value(px)
                    local abs = track.AbsolutePosition.X
                    local width = track.AbsoluteSize.X
                    if width <= 0 then return end
                    local alpha = math.clamp((px - abs) / width, 0, 1)
                    apply(min_v + alpha * (max_v - min_v), true)
                end

                local drag_btn = Instance.new('TextButton')
                drag_btn.BackgroundTransparency = 1
                drag_btn.Text = ''
                drag_btn.Size = UDim2.new(1, 0, 0, 20)
                drag_btn.Position = UDim2.new(0, 0, 0, 17)
                drag_btn.Parent = row

                drag_btn.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        pointer_to_value(input.Position.X)
                    end
                end)
                Connections['slider_move_' .. wflag] = UserInputService.InputChanged:Connect(function(input)
                    if not dragging then return end
                    if input.UserInputType == Enum.UserInputType.MouseMovement
                        or input.UserInputType == Enum.UserInputType.Touch then
                        pointer_to_value(input.Position.X)
                    end
                end)
                Connections['slider_end_' .. wflag] = UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)

                return { set = apply, get = function() return current end }
            end

            function ModuleManager:create_dropdown(opts)
