        end

        return TabManager
    end

    Connections['library_visiblity'] = UserInputService.InputBegan:Connect(function(input, process)
        if input.KeyCode ~= Enum.KeyCode.LeftControl then return end
        self._ui_open = not self._ui_open
        if getgenv().guilibraryVisible then set_gui_visibility(self._ui_open) end
        self:change_visiblity(self._ui_open)
    end)

    self._ui.Container.Handler.Minimize.MouseButton1Click:Connect(function()
        self._ui_open = not self._ui_open
        if getgenv().guilibraryVisible then set_gui_visibility(self._ui_open) end
        self:change_visiblity(self._ui_open)
    end)

    return self
end

return Library
