local Config = setmetatable({
    save = function(self, file_name, config)
        local ok, result = pcall(function()
            local flags = HttpService:JSONEncode(config)
            writefile('Synthesis/'..file_name..'.json', flags)
        end)
        if not ok then warn('failed to save config', result) end
    end,
    load = function(self, file_name, config)
        local ok, result = pcall(function()
            if not isfile('Synthesis/'..file_name..'.json') then
                self:save(file_name, config); return
            end
            local flags = readfile('Synthesis/'..file_name..'.json')
            if not flags then self:save(file_name, config); return end
            return HttpService:JSONDecode(flags)
        end)
        if not ok then warn('failed to load config', result) end
        if not result then
            result = {_flags = {}, _keybinds = {}, _library = {}}
        end
        return result
    end
}, Config)

