                dd.Parent = row
                local dc = Instance.new('UICorner')
                dc.CornerRadius = UDim.new(0, 6)
                dc.Parent = dd
                local dp = Instance.new('UIPadding')
                dp.PaddingLeft = UDim.new(0, 8)
                dp.Parent = dd

                local current = default
                local function select(v)
                    current = v
                    dd.Text = tostring(v)
                    Library._config._flags[wflag] = v
                    task.spawn(wcallback, v)
                end

                dd.MouseButton1Click:Connect(function()
                    if #options_list == 0 then return end
                    local idx = 1
                    for i, v in ipairs(options_list) do
                        if v == current then idx = i; break end
                    end
                    idx = idx % #options_list + 1
                    select(options_list[idx])
                end)

                return { set = select, get = function() return current end }
            end

